# RETIRED 2026-09-23. Kept (renamed, not deleted) so a `git revert` restores it.
#
# This workflow deployed with docker compose up -d, which RECREATES the container: the old one
# is stopped before the new one is healthy, so the site answered 502 during
# every deploy (the same failure that cut hub-api for about two minutes on
# 2026-09-23). The portfolio rule is zero-downtime deploys only.
#
# The project now deploys like the rest of the portfolio: push to the deploy
# branch on Forgejo -> signed webhook -> deploy-any on the EPYC ->
# /usr/local/bin/zero-downtime-deploy (the same binary `cb-deploy image-metadata` uses).
# See codelabs-core infra/deploy-webhook/README.md. Never run two deploy
# mechanisms on the same checkout at once: re-enabling this means removing the
# Forgejo webhook first.
#
name: Deploy

on:
  push:
    branches: [main]
    paths-ignore:
      # Tocar el propio workflow no puede desplegar produccion. Se anadio el
      # 2026-08-24 al renombrar "Xeon" por "EPYC": sin esto, un cambio de nombre
      # habria disparado un deploy real en 11 proyectos a la vez, varios de ellos
      # sin desplegar desde hacia dos meses.
      - '.github/**'
      - '**.md'

concurrency:
  group: deploy-image-metadata
  cancel-in-progress: false

jobs:
  deploy:
    runs-on: [self-hosted, linux, x64, epyc]
    steps:
      - name: Deploy image-metadata to EPYC
        run: |
          set -euo pipefail
          COMPOSE_DIR="/etc/dokploy/compose/compose-override-1080p-monitor-d9x6az/code"
          PROJECT="compose-override-1080p-monitor-d9x6az"
          COMPOSE_FILE="docker-compose.prod.yml"
          cd "$COMPOSE_DIR"
          git fetch origin main && git reset --hard origin/main
          docker compose -f "$COMPOSE_FILE" -p "$PROJECT" build
          docker compose -f "$COMPOSE_FILE" -p "$PROJECT" up -d
          echo "Checking containers are running..."
          sleep 10
          FAILED=$(docker compose -f "$COMPOSE_FILE" -p "$PROJECT" ps --status exited --quiet | wc -l)
          if [ "$FAILED" -gt 0 ]; then
            echo "ERROR: $FAILED container(s) exited after deploy"
            docker compose -f "$COMPOSE_FILE" -p "$PROJECT" logs --tail=50
            exit 1
          fi
          echo "Deploy completed successfully"
